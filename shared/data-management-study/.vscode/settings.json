{
  // Copilot のチャット・補完など組み込み AI 機能を無効化
  "chat.disableAIFeatures": false,

  // インデントと保存時の整形
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.formatOnSave": false,
  "editor.defaultFormatter": null,
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },

  // プロジェクトに導入済みの TypeScript を選択できるようにする
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.tsserver.maxMemory": 4096,
  "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
  "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
  "js/ts.validate.enabled": true,

  // Tailwind CSS 4 とコメント付き設定ファイル
  "files.associations": {
    "*.css": "tailwindcss",
    "wrangler.json": "jsonc"
  },

  // 依存パッケージと Next.js / OpenNext / Wrangler の生成物を非表示
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/.next": true,
    "**/.open-next": true,
    "**/.wrangler": true,
    "**/dist": true,
    "**/out": true,
    "**/coverage": true,
    "**/*.tsbuildinfo": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/.next/**": true,
    "**/.open-next/**": true,
    "**/.wrangler/**": true,
    "**/dist/**": true,
    "**/out/**": true,
    "**/coverage/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.open-next": true,
    "**/.wrangler": true,
    "**/dist": true,
    "**/out": true,
    "**/coverage": true,
    "**/*.tsbuildinfo": true
  },
  "search.followSymlinks": false,

  // コンテナ内でのポート自動転送を抑制
  "remote.autoForwardPorts": false,
  "remote.restoreForwardedPorts": false,

  // 表示設定
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false
}
