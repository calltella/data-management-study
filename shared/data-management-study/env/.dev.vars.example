# Worker側だけで使用。実値は.dev.vars（Git除外）へ設定。
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# 新規登録の作成・有効化・失敗時の取り消しと、Auth削除専用。ブラウザーへ公開しない。
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# 共有Authプロジェクトではfalseを維持（学習アプリのみ削除）。専用プロジェクトの場合だけtrue。
DELETE_AUTH_USER=false

# 生成パスワードのメール本文を送信するMailgun API。SupabaseのSMTP設定とは別に必要。
MAILGUN_API_KEY=YOUR_MAILGUN_API_KEY
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=DM STUDY <no-reply@mg.example.com>
